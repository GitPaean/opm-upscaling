# Eclipse input decks and grid files use '\n' line endings by specification
# and are parsed byte-for-byte (no newline translation on Windows). Force LF
# at checkout so that a clone with core.autocrlf=true on Windows does not
# corrupt the test data.
*.DATA    text eol=lf
*.data    text eol=lf
*.inc     text eol=lf
*.include text eol=lf
*.grdecl  text eol=lf
*.GRDECL  text eol=lf

# ... except this one, which upstream stores with CRLF. Marking it -text means
# git never translates it in either direction, so it is checked out byte-for-
# byte as upstream has it - the same protection the rules above give, without
# obliging this branch to rewrite all 10252 of its lines to LF and carry that
# rewrite as a permanent conflict against every upstream change to the file.
tests/input_data/grids/PeriodicTilted.grdecl -text
